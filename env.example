# KUSA FlightOps v5.20 - FAA NMS staging
# SERVER-SIDE ONLY. Do not put real credentials in GitHub.
NMS_CLIENT_ID=
NMS_CLIENT_SECRET=
NMS_AUTH_URL=https://api-staging.cgifederal-aim.com/v1/auth/token
NMS_BASE_URL=https://api-staging.cgifederal-aim.com/nmsapi/v1
NMS_RESPONSE_FORMAT=GEOJSON
NMS_ENVIRONMENT=STAGING

# FlightOps v5.26.0 account/data foundation
FLIGHTOPS_ADMIN_EMAIL=
FLIGHTOPS_ADMIN_PASSWORD=
FLIGHTOPS_ADMIN_NAME=KUSA Administrator
FLIGHTOPS_SESSION_DAYS=30
# Production: migrate the existing database before setting this path.
# GoDaddy durable private storage: /private/flightops/flightops.sqlite
FLIGHTOPS_DB_PATH=
# First installation only; never enable for an existing database.
FLIGHTOPS_INIT_DATABASE=false
# Transitional: leave false for v5.26.0 initial deployment/testing.
FLIGHTOPS_AUTH_REQUIRED=false
