{
  "name": "kusa-flightops",
  "version": "5.26.18",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prestart": "node scripts/verify-release.cjs",
    "build": "npm run release:verify",
    "release:manifest": "node scripts/release-manifest.cjs",
    "release:verify": "node scripts/verify-release.cjs",
    "release:smoke": "node scripts/smoke-release.cjs",
    "release:test-gates": "node --test tests/release-gates.test.cjs",
    "release:check": "npm run release:verify && npm run release:test-gates && npm run release:smoke",
    "release:layout": "node tests/ipad-trip-layout.cjs"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "playwright": "1.61.0"
  }
}
