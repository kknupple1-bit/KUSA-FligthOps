{
  "name": "kusa-flightops",
  "version": "5.26.25",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prestart": "node scripts/verify-release.cjs",
    "build": "npm run release:verify",
    "release:manifest": "node scripts/release-manifest.cjs",
    "release:verify": "node scripts/verify-release.cjs",
    "release:smoke": "node scripts/smoke-release.cjs",
    "release:test-gates": "node --test tests/release-gates.test.cjs",
    "release:check": "npm run release:verify && npm run release:test-gates && npm run release:test-update && npm run release:test-storage && npm run release:test-sync && npm run release:test-fuel && npm run release:test-n1 && npm run release:test-obstacle && npm run release:test-pull-refresh && npm run release:smoke",
    "release:layout": "node tests/ipad-trip-layout.cjs && node tests/numeric-keypads.cjs",
    "release:test-n1": "node --test tests/n1-gates.test.cjs",
    "release:test-fuel": "node --test tests/fuel-accounting.test.cjs",
    "release:test-sync": "node --test tests/cross-device-sync.test.cjs",
    "release:test-obstacle": "node --test tests/obstacle-gates.test.cjs",
    "release:test-pull-refresh": "node --test tests/pull-refresh.test.cjs",
    "release:test-storage": "node --test tests/database-storage.test.cjs",
    "release:test-update": "node --test tests/app-update.test.cjs"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "playwright": "1.61.0"
  }
}
